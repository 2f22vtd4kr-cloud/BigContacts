entrypoint = "README.md"
modules = ["nodejs-20", "postgresql-16"]

hidden = [".config", ".git", "node_modules", "dist", ".cache", ".local"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "cloudrun"
router = "application"
run = ["sh", "-c", "pnpm --filter @workspace/api-server run start"]

[env]
PORT = "8080"
ENABLE_AUTO_PIPELINE = "false"
RESEARCH_DEPTH = "standard"
REDIS_URL = "redis://localhost:6379"

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 23695
externalPort = 3001

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow]]
name = "API Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/api-server run start"
waitForPort = 8080

# Optional local Vite desk — MUST use 23695, never 8080 (API owns 8080 and serves dist/public at /)
[[workflows.workflow]]
name = "Start Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=23695 pnpm --filter @workspace/apex-finder run dev"
waitForPort = 23695
