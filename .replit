modules = ["nodejs-22", "python-base-3.13", "postgresql-16"]

run = "bash scripts/replit-boot.sh"

[deployment]
router = "application"
deploymentTarget = "autoscale"
run = ["sh", "-c", "bash scripts/replit-boot.sh"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "sequential"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false
outputType = "webview"

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/replit-boot.sh"
waitForPort = 8080

[[ports]]
localPort = 8080
externalPort = 80

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
NODE_ENV = "development"
APEX_CAPTURE_MODEL_PROMPTS = "true"
APEX_MODEL_AUDIT_INCLUDE_CONTACT_DATA = "true"
APEX_MODEL_AUDIT_FILE = "audits/★_STARRED_APEX_ATLAS_SEQUENTIAL_AUDIT_2026-10-26_FRESH_REPLIT_IMPORT_RUN_02_MODEL_TRACE.md"
APEX_CAPTURE_MODEL_PROMPTS_IN_TEST = "false"
APEX_MODEL_AUDIT_ALLOW_VISIBLE_FILE = "true"
