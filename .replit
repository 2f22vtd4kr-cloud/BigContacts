modules = ["nodejs-22", "python-base-3.13", "postgresql-16"]

run = "bash scripts/replit-boot.sh"

[deployment]
router = "application"
deploymentTarget = "autoscale"
run = ["sh", "-c", "bash scripts/replit-boot.sh"]

[deployment.postBuild]
args = ["npm", "exec", "--yes", "--package=pnpm@9.15.9", "--", "pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "sequential"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm exec --yes --package=pnpm@9.15.9 -- pnpm install --frozen-lockfile && bash scripts/replit-boot.sh"
waitForPort = 8080

[[ports]]
localPort = 8080
externalPort = 80

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]
