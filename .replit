entrypoint = "README.md"
modules = ["nodejs-22", "web", "bash", "python-3.12", "postgresql-16"]
hidden = [".config", ".git", "node_modules", "dist", ".cache", ".local"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "cloudrun"
router = "application"
run = ["bash scripts/replit-boot.sh"]

[env]
PORT = "8080"
NODE_ENV = "production"
ENABLE_AUTO_PIPELINE = "false"
INSTALL_PYTHON_OSINT = "false"
APEX_SKIP_SEMANTIC = "1"
CI = "true"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Apex Atlas API"
waitForPort = 8080

[[workflows.workflow]]
name = "Apex Atlas API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/replit-boot.sh"
waitForPort = 8080

[userenv]

[userenv.shared]
NODE_OPTIONS = "--max-old-space-size=1536"
NODE_ENV = "production"
RESEARCH_DEPTH = "standard"
APEX_SKIP_SEMANTIC = "1"
CI = "true"
ENABLE_AUTO_PIPELINE = "false"
INSTALL_PYTHON_OSINT = "false"
PORT = "8080"
