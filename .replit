modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Redis"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/apex-finder: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/apex-mobile: expo"

[[workflows.workflow]]
name = "Redis"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "redis-server --port 6379 --save '' --appendonly no"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "artifacts/apex-finder: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/apex-finder run dev"
waitForPort = 23695

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "artifacts/apex-mobile: expo"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/apex-mobile run dev"
waitForPort = 22796

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ENABLE_AUTO_PIPELINE = "false"
REDIS_URL = "redis://localhost:6379"
