modules = ["nodejs-24", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/apex-finder"

[deployment]
router = "application"
deploymentTarget = "cloudrun"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
compatiblePackages = []
startCommand = "pnpm --filter @workspace/api-server run start"

[userenv]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Redis"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Frontend"

[[workflows.workflow]]
name = "API Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
waitForPort = 8080

[[workflows.workflow]]
name = "Start Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/apex-finder run dev"
waitForPort = 23695

[[workflows.workflow]]
name = "Redis"
author = "agent"

[workflows.workflow.metadata]
agentRequire = "redis"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "redis-server --daemonize yes --port 6379 --bind 127.0.0.1 --dir /tmp --dbfilename apex-redis.rdb --save \\\"\\\" && redis-cli ping"

[agent]
stack = "PNPM_WORKSPACE"
mockUpfiles = ["artifacts/mockup-sandbox/**"]

[userenv.shared]
REDIS_URL = "redis://localhost:6379"
PORT = "8080"
ENABLE_AUTO_PIPELINE = "false"

[nix]
channel = "stable-24.11"
packages = ["redis"]
