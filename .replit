entrypoint = "README.md"
modules = ["nodejs-22", "web", "bash", "python-3.12", "postgresql-16"]
hidden = [".config", ".git", "node_modules", "dist", ".cache", ".local"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "cloudrun"
router = "application"
run = ["NODE_ENV=production bash scripts/replit-boot.sh"]

[env]
PORT = "8080"
NODE_ENV = "development"
ENABLE_AUTO_PIPELINE = "false"
INSTALL_PYTHON_OSINT = "false"
APEX_SKIP_SEMANTIC = "1"
CI = "true"

[workflows]

[userenv]

[userenv.shared]
NODE_OPTIONS = "--max-old-space-size=1536"
NODE_ENV = "development"
RESEARCH_DEPTH = "standard"
APEX_SKIP_SEMANTIC = "1"
CI = "true"
ENABLE_AUTO_PIPELINE = "false"
INSTALL_PYTHON_OSINT = "false"
PORT = "8080"
